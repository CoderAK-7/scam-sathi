{
  "manifest_version": 3,
  "name": "ScamSathi Universal Scam Guardian",
  "version": "1.0.0",
  "description": "Local-first Indian cyber scam guardian for Gmail, WhatsApp Web & SMS. Detects phishing, UPI traps, and deceptive links.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ScamSathi Universal Scam Guardian"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "detection/detector.js",
        "platforms/gmail.js",
        "platforms/whatsapp.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

